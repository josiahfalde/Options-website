{
  "name": "flywheel-options",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Flywheel - Wheel-strategy options premium analytics. Your broker shows trades; Flywheel shows momentum.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
